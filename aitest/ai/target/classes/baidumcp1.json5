{
  "mcpServers": {
    "baidu-map": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "baidu-map-mcp",
        "mcp-server-baidu-map"
      ]
    },
    "gitlab": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "gitlab-mcp",
        "mcp-server-gitlab"
      ]
    }
  }
}

